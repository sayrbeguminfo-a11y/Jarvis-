    <script>
        // State
        const API_KEY = ""; // Provided by Canvas environment
        const API_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${API_KEY}`;
        
        let chatHistory = []; // Stores the API format history {role, parts}
        let isGenerating = false;

        // DOM Elements
        const form = document.getElementById('chat-form');
        const input = document.getElementById('prompt-input');
        const sendBtn = document.getElementById('send-btn');
        const messagesList = document.getElementById('messages-list');
        const emptyState = document.getElementById('empty-state');
        const chatContainer = document.getElementById('chat-container');
        const chatAnchor = document.getElementById('chat-anchor');
        const typingIndicator = document.getElementById('typing-indicator');
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');

        // Configure Marked.js options
        marked.setOptions({
            breaks: true, // Convert \n to <br>
            gfm: true     // GitHub Flavored Markdown
        });

        // Auto-resize textarea
        function adjustTextareaHeight() {
            input.style.height = 'auto'; // Reset height
            input.style.height = Math.min(input.scrollHeight, 200) + 'px'; // Set to scrollHeight up to max 200px
            
            if (input.scrollHeight > 200) {
                input.style.overflowY = 'auto';
            } else {
                input.style.overflowY = 'hidden';
            }

            // Enable/disable send button based on content
            if (input.value.trim().length > 0 && !isGenerating) {
                sendBtn.disabled = false;
                sendBtn.classList.remove('bg-gray-700', 'text-gray-500');
                sendBtn.classList.add('bg-gray-200', 'text-black', 'hover:bg-white');
            } else {
                sendBtn.disabled = true;
                sendBtn.classList.add('bg-gray-700', 'text-gray-500');
                sendBtn.classList.remove('bg-gray-200', 'text-black', 'hover:bg-white');
            }
        }

        input.addEventListener('input', adjustTextareaHeight);

        // Handle Enter key (send) vs Shift+Enter (newline)
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault(); // Prevent default newline
                if (!sendBtn.disabled) {
                    form.dispatchEvent(new Event('submit'));
                }
            }
        });

        // Sidebar Toggle Logic
        let isSidebarOpen = false;
        function toggleSidebar() {
            isSidebarOpen = !isSidebarOpen;
            
            if (window.innerWidth < 768) {
                // Mobile behavior
                if (isSidebarOpen) {
                    sidebar.classList.remove('-translate-x-full');
                    sidebar.classList.add('w-[280px]');
                    sidebarOverlay.classList.remove('hidden');
                } else {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                }
            } else {
                // Desktop behavior (collapsible)
                if (isSidebarOpen) {
                    sidebar.classList.remove('md:w-[280px]');
                    sidebar.classList.add('md:w-0');
                } else {
                    sidebar.classList.add('md:w-[280px]');
                    sidebar.classList.remove('md:w-0');
                }
            }
        }

        // Helper for suggestion buttons
        function setPrompt(text) {
            input.value = text;
            adjustTextareaHeight();
            input.focus();
        }

        function startNewChat() {
            chatHistory = [];
            messagesList.innerHTML = '';
            emptyState.style.display = 'flex';
            if(window.innerWidth < 768) toggleSidebar(); // close mobile menu
        }

        function scrollToBottom() {
            chatAnchor.scrollIntoView({ behavior: 'smooth' });
        }

        function createMessageElement(text, role) {
            const isUser = role === 'user';
            const wrapper = document.createElement('div');
            wrapper.className = `flex w-full ${isUser ? 'justify-end' : 'justify-start'}`;

            const innerContainer = document.createElement('div');
            innerContainer.className = `flex gap-4 max-w-[90%] md:max-w-[85%] ${isUser ? 'flex-row-reverse' : 'flex-row'}`;

            // Avatar
            const avatar = document.createElement('div');
            avatar.className = 'w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center mt-1 select-none';
            
            if (isUser) {
                avatar.className += ' bg-gradient-to-tr from-blue-500 to-purple-500 text-white font-semibold text-sm';
                avatar.textContent = 'U';
            } else {
                avatar.className += ' bg-gradient-to-br from-blue-400 via-purple-400 to-red-400';
                avatar.innerHTML = '<i class="ph-fill ph-sparkle text-white text-sm"></i>';
            }

            // Message Body
            const messageBody = document.createElement('div');
            messageBody.className = `px-5 py-3.5 rounded-3xl ${isUser ? 'bg-gemini-userBubble text-gray-100 rounded-tr-sm' : 'bg-transparent text-gray-100 prose prose-invert max-w-none w-full'}`;
            
            if (isUser) {
                // User text is plain
                messageBody.textContent = text;
            } else {
                // AI text is markdown - parse and sanitize
                const rawHtml = marked.parse(text);
                const cleanHtml = DOMPurify.sanitize(rawHtml);
                messageBody.innerHTML = cleanHtml;
            }

            innerContainer.appendChild(avatar);
            innerContainer.appendChild(messageBody);
            wrapper.appendChild(innerContainer);

            return wrapper;
        }

        function appendMessage(text, role) {
            if (emptyState.style.display !== 'none') {
                emptyState.style.display = 'none';
            }
            const msgEl = createMessageElement(text, role);
            messagesList.appendChild(msgEl);
            scrollToBottom();
        }

        function setGeneratingState(generating) {
            isGenerating = generating;
            if (generating) {
                sendBtn.disabled = true;
                typingIndicator.classList.remove('hidden');
                scrollToBottom();
            } else {
                typingIndicator.classList.add('hidden');
                adjustTextareaHeight(); // re-evaluates button state based on input
            }
        }

        async function fetchGeminiResponse(userText) {
            // Add user message to local context history
            chatHistory.push({
                role: "user",
                parts: [{ text: userText }]
            });

            const payload = {
                contents: chatHistory,
                // Using standard generation config
                generationConfig: {
                    temperature: 0.7,
                }
            };

            try {
                const response = await fetch(API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();
                
                if (result.candidates && result.candidates.length > 0) {
                    const aiText = result.candidates[0].content.parts[0].text;
                    
                    // Add AI response to local context history
                    chatHistory.push({
                        role: "model",
                        parts: [{ text: aiText }]
                    });

                    return aiText;
                } else {
                    throw new Error("No candidates in response");
                }
            } catch (error) {
                console.error("API Error:", error);
                return "**Error:** Sorry, I encountered an issue connecting to the Gemini service. Please check the console or try again later.";
            }
        }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = input.value.trim();
            
            if (!text || isGenerating) return;

            // 1. UI updates for user input
            input.value = '';
            input.style.height = 'auto'; // reset height instantly
            appendMessage(text, 'user');
            setGeneratingState(true);

            // 2. Fetch API
            const aiResponse = await fetchGeminiResponse(text);

            // 3. UI updates for AI response
            setGeneratingState(false);
            appendMessage(aiResponse, 'model');
        });

        // Initial setup
        input.focus();

    </script>
</body>
</html>
